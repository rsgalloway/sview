#!/usr/bin/env envstack
include: [default]
all: &all
  SVIEW_CONFIG_DIR: ${SVIEW_CONFIG_DIR:=${HOME}/.config/sview}
  SVIEW_FILE_HANDLER_MODE: ${SVIEW_FILE_HANDLER_MODE:=system}
  SVIEW_FILE_HANDLER_COMMAND: ${SVIEW_FILE_HANDLER_COMMAND:=}
  SVIEW_SEQUENCE_HANDLER_MODE: ${SVIEW_SEQUENCE_HANDLER_MODE:=expand}
  SVIEW_SEQUENCE_HANDLER_COMMAND: ${SVIEW_SEQUENCE_HANDLER_COMMAND:=}
darwin:
  <<: *all
linux:
  <<: *all
windows:
  <<: *all
